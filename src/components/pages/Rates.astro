---
// Contenuti statici provvisori: verranno sostituiti dai dati di DatoCMS.
import { seo } from '../../data/seo';
import BaseLayout from '../templates/BaseLayout.astro';
import PageTitle from '../organisms/PageTitle.astro';
import DataTable from '../molecules/DataTable.astro';
import InfoCard from '../molecules/InfoCard.astro';
import PriceCard from '../molecules/PriceCard.astro';
import Button from '../atoms/Button.astro';
import { rooms } from '../../data/rooms';
import { breakfastRates, minimumStay, ratesUpdated, roomRates } from '../../data/rates';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const c = {
  it: {
    updated: 'Ultimo aggiornamento del listino',
    minStay: 'Soggiorno minimo',
    minStayText:
      'La preghiamo di contattarci telefonicamente per conoscere la durata minima del soggiorno. Potremo verificare insieme la disponibilità e valutare se ci sono sconti o soluzioni personalizzate per il tuo soggiorno.',
    period: 'Periodo',
    minimum: 'Minimo',
    nights: (n: number) => `${n} giorni`,
    tax: 'Previsto il pagamento della tassa di soggiorno in struttura: 3,00€ a persona per notte per massimo 5 notti. Sconti sono disponibili per soggiorni superiori a 1 settimana.',
    roomPrices: 'Prezzi camere senza colazione',
    roomPricesNote: 'Prezzi per camera, a notte.',
    from: 'da',
    unit: '/notte',
    euro: (p: number) => `${p} €`,
    goodToKnow: 'Da sapere',
    taxTitle: 'Tassa di soggiorno',
    depositTitle: 'Caparra e pagamento',
    breakfast: 'Colazione',
    price: 'Prezzo',
    perPerson: (p: number) => `+${p}€/persona`,
    deposit:
      'All’atto della prenotazione si paga il 100% della prima notte oppure il 30% del costo totale del soggiorno attraverso un bonifico istantaneo o altri metodi di pagamento, il restante va saldato al momento del check-in.',
    checkText:
      "Check in dalle 15:00 alle 21:00, check out dalle 7:00 alle 11:00. Oltre tale fascia d'orario contattare la struttura poiché potrebbe esserci un supplemento di 5€ all'ora dopo le 21:00, 10€ all'ora prima delle 7:00.",
    cancellation: 'Termini di Cancellazione',
    cancellationText:
      'In caso di cancellazioni o modifiche il deposito non verrà rimborsato. In caso di mancata presentazione viene addebitato l’intero importo del soggiorno, la stessa regola vale per partenza anticipata.',
  },
  en: {
    updated: 'Last updated',
    minStay: 'Minimum stay',
    minStayText:
      'Please call us to check on the minimum stay, as we can verify availability and discuss potential discounts or customized solutions for your trip.',
    period: 'Period',
    minimum: 'Minimum',
    nights: (n: number) => `${n} days`,
    tax: 'A tourist tax of € 3.00 per person per night is payable at the property, up to a maximum of 5 consecutive nights. Discounts are available for stays over 1 week.',
    roomPrices: 'Room prices without breakfast',
    roomPricesNote: 'Prices per room, per night.',
    from: 'from',
    unit: '/night',
    euro: (p: number) => `€${p}`,
    goodToKnow: 'Good to know',
    taxTitle: 'Tourist tax',
    depositTitle: 'Deposit and payment',
    breakfast: 'Breakfast',
    price: 'Price',
    perPerson: (p: number) => `+${p}€/person`,
    deposit:
      'When booking you pay 100% of the first night or 30% of the total cost of the stay through an instant bank transfer or other payment methods, the remaining must be paid at check-in.',
    checkText:
      'Check-in is from 3:00 PM to 9:00 PM. Check-out is from 7:00 AM to 11:00 AM. For arrivals or departures outside these times, please contact the property directly. An additional fee may apply: €5 per hour for check-ins after 9:00 PM, and €10 per hour for check-outs before 7:00 AM.',
    cancellation: 'Cancellation terms',
    cancellationText:
      'In case of cancellations or changes the deposit will not be refunded. The full amount of the stay is charged in case of no-show, the same rule applies to early departure.',
  },
}[lang];

const roomOf = (slug: string) => rooms.find((r) => r.slug === slug);
const roomName = (slug: string) => roomOf(slug)?.name[lang] ?? slug;
const bookHref = (slug: string) => `${localizePath('/prenota', lang)}?stanza=${slug}`;

// Tabella unica: una riga per periodo, colonne raggruppate per camera
const periods = roomRates[0].rows.map((row) => row.period);
const priceColumns = roomRates.flatMap((rates) =>
  rates.columns.map((col) => ({ label: col.label[lang], guests: col.guests, note: col.note?.[lang] })),
);
const priceGroups = [{ label: '', span: 1 }, ...roomRates.map((rates) => ({ label: roomName(rates.room), span: rates.columns.length }))];
const priceRows = periods.map((period) => [
  period[lang],
  ...roomRates.flatMap((rates) => {
    const row = rates.rows.find((r) => r.period.it === period.it);
    return rates.columns.map((_, i) => (row ? c.euro(row.prices[i]) : '—'));
  }),
]);

const heading = 'font-sans text-2xl font-bold text-secondary';
---

<BaseLayout title={t('nav.rates')} description={seo.rates.description[lang]}>
  <PageTitle>{t('nav.rates')}</PageTitle>

  <div class="container mx-auto max-w-5xl space-y-14 px-4 py-14">
    <p class="text-center text-sm italic">{c.updated}: {ratesUpdated[lang]}</p>

    <!-- Riepilogo: prezzo di partenza e prenotazione per camera -->
    <section class="grid gap-6 md:grid-cols-2">
      {
        roomRates.map((rates) => {
          const room = roomOf(rates.room);
          return (
            room && (
              <PriceCard
                name={room.name[lang]}
                image={room.image}
                fromLabel={c.from}
                price={c.euro(Math.min(...rates.rows.flatMap((r) => r.prices)))}
                unit={c.unit}
                cta={{ label: t('cta.book'), href: bookHref(room.slug) }}
              />
            )
          );
        })
      }
    </section>

    <section>
      <h2 class={heading}>{c.roomPrices}</h2>
      <p class="mt-2">{c.roomPricesNote}</p>
      <DataTable caption={c.roomPrices} groups={priceGroups} columns={[{ label: c.period }, ...priceColumns]} rows={priceRows} />
    </section>

    <section>
      <h2 class={heading}>{c.breakfast}</h2>
      <DataTable
        caption={c.breakfast}
        columns={[{ label: c.breakfast }, { label: c.price }]}
        rows={breakfastRates.map((b) => [b.name[lang], c.perPerson(b.price)])}
      />
    </section>

    <section>
      <h2 class={heading}>{c.minStay}</h2>
      <p class="mt-2 text-lg leading-relaxed">{c.minStayText}</p>
      <DataTable
        caption={c.minStay}
        columns={[{ label: c.period }, { label: c.minimum }]}
        rows={minimumStay.map((m) => [m.period[lang], c.nights(m.nights)])}
      />
    </section>

    <section>
      <h2 class={heading}>{c.goodToKnow}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <InfoCard icon="fa6-solid:receipt" title={c.taxTitle}>{c.tax}</InfoCard>
        <InfoCard icon="fa6-solid:credit-card" title={c.depositTitle}>{c.deposit}</InfoCard>
        <InfoCard icon="fa6-solid:clock" title="Check in / Check out">{c.checkText}</InfoCard>
        <InfoCard icon="fa6-solid:calendar-xmark" title={c.cancellation}>{c.cancellationText}</InfoCard>
      </div>
    </section>

    <div class="text-center">
      <Button href={localizePath('/prenota', lang)}>{t('cta.book')}</Button>
    </div>
  </div>
</BaseLayout>
