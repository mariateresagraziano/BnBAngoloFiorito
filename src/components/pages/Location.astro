---
import BaseLayout from '../templates/BaseLayout.astro';
import PageTitle from '../organisms/PageTitle.astro';
import PlacesSection from '../organisms/PlacesSection.astro';
import CtaBand from '../organisms/CtaBand.astro';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = {
  it: { title: 'Civitavecchia e Dintorni', ctaTitle: 'Vieni a scoprire i dintorni' },
  en: { title: 'Civitavecchia and surroundings', ctaTitle: 'Come and explore the area' },
}[lang];
---

<BaseLayout title={content.title}>
  <PageTitle>{content.title}</PageTitle>
  <PlacesSection lang={lang} />
  <CtaBand title={content.ctaTitle} cta={{ label: t('cta.book'), href: localizePath('/prenota', lang) }} />
</BaseLayout>
