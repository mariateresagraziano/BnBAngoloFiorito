---
import '../../styles/global.css';
import TopBar from '../organisms/TopBar.astro';
import Header from '../organisms/Header.astro';
import MobileNav from '../organisms/MobileNav.astro';
import Footer from '../organisms/Footer.astro';
import { getImage } from 'astro:assets';
import { getLangFromUrl, languages, switchLangPath, type Lang } from '../../i18n/ui';
import { shareImage, siteName } from '../../data/seo';

interface Props {
  title: string;
  description?: string;
  /** Pagine da non indicizzare (es. 404): niente canonical né versioni linguistiche */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// "Camere · B&B Angolo Fiorito" (il nome non viene ripetuto se il titolo lo contiene già)
const fullTitle = title.includes('Angolo Fiorito') ? title : `${title} · ${siteName}`;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({ lang: l, href: new URL(switchLangPath(Astro.url, l), site).href }));
const ogLocale = { it: 'it_IT', en: 'en_US' }[lang];

// Anteprima dei link condivisi: 1200×630 ritagliata
const og = await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = new URL(og.src, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Anteprima per WhatsApp, Facebook, X… -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="bg-base-100 text-base-content font-sans">
    <!-- Il drawer di daisyUI gestisce il menu mobile solo con CSS (checkbox) -->
    <div class="drawer drawer-end">
      <input id="nav-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex min-h-screen flex-col">
        <TopBar />
        <Header />
        <main class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>
      <MobileNav />
    </div>
  </body>
</html>
