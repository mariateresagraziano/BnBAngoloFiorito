---
// Bottone del sito: <a> se riceve href, altrimenti <button>.
// "primary" = CTA principale, giallo (ex m-btn-yellow). "secondary" = CTA secondaria, verde scuro.
// Forma a pillola come i link (pill-link); l'hover scurisce lo stesso colore (default daisyUI) e solleva il bottone.
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  block?: boolean;
  size?: 'sm' | 'md';
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'>;

const { variant = 'primary', href, type = 'button', block = false, size = 'md', class: className, ...rest } = Astro.props;

const classes = [
  'btn rounded-full border-0 font-bold tracking-wider uppercase',
  size === 'sm' ? 'btn-sm px-5' : 'px-8',
  'transition duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 active:shadow-sm',
  'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
  variant === 'primary' ? 'btn-accent' : 'btn-secondary',
  { 'btn-block': block },
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
