---
// Testo a sinistra (slot) e mappa Google a destra (Chi siamo).
import MapEmbed from '../atoms/MapEmbed.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="container mx-auto grid items-center gap-10 px-4 py-16 lg:grid-cols-2">
  <div>
    <h3 class="text-4xl">{title}</h3>
    <div class="mt-6 space-y-4 text-lg leading-relaxed">
      <slot />
    </div>
  </div>
  <MapEmbed class="aspect-4/3" />
</section>
