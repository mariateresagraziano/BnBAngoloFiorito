---
// Elenco di blocchi foto + testo a lati alterni (pagine Servizi e Location).
import MediaBlock from '../molecules/MediaBlock.astro';

interface Item {
  slug: string;
  image: ImageMetadata;
  title: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="bg-base-200 py-16">
  <div class="container mx-auto flex max-w-6xl flex-col gap-8 px-4">
    {
      items.map((item, i) => (
        <MediaBlock image={item.image} alt={item.title} reverse={i % 2 === 1}>
          <h3 id={item.slug} class="scroll-mt-32 text-3xl">
            {item.title}
          </h3>
          <p class="mt-4 text-lg leading-relaxed">{item.text}</p>
        </MediaBlock>
      ))
    }
  </div>
</section>
