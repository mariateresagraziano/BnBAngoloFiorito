---
import { getLangFromUrl, localizePath, nav, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="drawer-side z-50">
  <label for="nav-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
  <ul class="menu min-h-full w-72 bg-base-100 p-4 text-lg">
    {
      nav.map((item) => (
        <li>
          <a href={localizePath(item.href, lang)}>{t(item.key)}</a>
          {item.children && (
            <ul>
              {item.children.map((child) => (
                <li>
                  <a href={localizePath(child.href, lang)}>{t(child.key)}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</div>
