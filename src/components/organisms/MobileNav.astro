---
import { getLangFromUrl, localizePath, nav, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (localizePath(href, lang).replace(/\/$/, '') || '/') === current;
---

<div class="drawer-side z-50">
  <label for="nav-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
  <ul class="menu min-h-full w-72 bg-base-100 p-4 text-base tracking-wider uppercase">
    {
      nav.map((item) => (
        <li>
          <a href={localizePath(item.href, lang)} class="pill-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {t(item.key)}
          </a>
        </li>
      ))
    }
  </ul>
</div>
