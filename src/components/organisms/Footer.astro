---
import Logo from '../atoms/Logo.astro';
import ContactList from '../molecules/ContactList.astro';
import SocialLinks from '../molecules/SocialLinks.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-primary text-primary-content">
  <div class="container mx-auto px-4 py-8">
    <div class="grid items-center gap-6 md:grid-cols-[1fr_3fr_1fr]">
      <Logo variant="white" class="mx-auto w-32 md:mx-0" />
      <ContactList direction="col" />
      <SocialLinks class="justify-center md:justify-end" />
    </div>

    <div class="mt-6 flex flex-col items-center justify-between gap-2 border-t border-white/60 pt-4 text-sm md:flex-row">
      <a class="hover:text-secondary" href={localizePath('/regolamento', lang)}>{t('footer.rules')}</a>
      <a class="hover:text-secondary" href={localizePath('/policy', lang)}>{t('footer.privacy')}</a>
      <span>Designed by Maria Teresa Graziano</span>
    </div>
  </div>
</footer>
