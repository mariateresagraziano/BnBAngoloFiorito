---
// Form di contatto/prenotazione: invia a /api/mail.php (PHP su Aruba) e mostra l'esito senza ricaricare.
// Antispam: Cloudflare Turnstile + campo nascosto "website".
import Button from '../atoms/Button.astro';
import FormField from '../atoms/FormField.astro';
import PolicyConsent from '../molecules/PolicyConsent.astro';
import { rooms } from '../../data/rooms';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  type: 'contatti' | 'prenotazione';
}

const { lang, type } = Astro.props;
const t = useTranslations(lang);

// Chiave pubblica; senza .env si usa la chiave di test di Cloudflare
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const messages = {
  sent: t('form.sent'),
  invalid: t('form.invalid'),
  captcha: t('form.captcha'),
  error: t('form.error'),
};
const input = 'input w-full';
---

<form class="contact-form flex flex-col gap-2" action="/api/mail.php" method="post" data-messages={JSON.stringify(messages)}>
  <input type="hidden" name="type" value={type} />

  {
    type === 'prenotazione' && (
      <>
        <div class="grid gap-x-4 sm:grid-cols-2">
          <FormField label={t('form.room')} required>
            <select name="stanza" class="select w-full" required>
              {rooms.map((room) => (
                <option value={room.slug}>{room.name[lang]}</option>
              ))}
            </select>
          </FormField>
          <FormField label={t('form.guests')} required>
            <input type="number" name="ospiti" min="1" max="4" step="1" value="2" class={input} required />
          </FormField>
        </div>
        <div class="grid gap-x-4 sm:grid-cols-2">
          <FormField label={t('form.arrival')} required>
            <input type="date" name="arrivo" class={input} required />
          </FormField>
          <FormField label={t('form.departure')} required>
            <input type="date" name="partenza" class={input} required disabled />
          </FormField>
        </div>
      </>
    )
  }

  <FormField label={t('form.name')} required>
    <input type="text" name="nome" autocomplete="name" maxlength="100" class={input} required />
  </FormField>
  <FormField label={t('form.email')} required>
    <input type="email" name="email" autocomplete="email" maxlength="200" class={input} required />
  </FormField>
  <FormField label={t('form.message')} required>
    <textarea name="messaggio" rows="5" maxlength="5000" class="textarea w-full" required></textarea>
  </FormField>

  <!-- Honeypot: nascosto alle persone, i bot lo compilano -->
  <div class="hidden" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="mt-2">
    <PolicyConsent lang={lang} />
  </div>

  <div class="cf-turnstile mt-4" data-sitekey={siteKey} data-language={lang}></div>

  <div>
    <Button type="submit" class="mt-4">{t('form.send')}</Button>
  </div>
  <p class="form-response alert mt-4 hidden" role="status" aria-live="polite"></p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: (el?: Element) => void };
    }
  }

  const toISODate = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const messages = JSON.parse(form.dataset.messages ?? '{}') as Record<string, string>;
    const response = form.querySelector<HTMLElement>('.form-response')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    // Date: l'arrivo parte da oggi (calcolato nel browser, non in build); la partenza dal giorno dopo l'arrivo
    const arrival = form.querySelector<HTMLInputElement>('input[name="arrivo"]');
    const departure = form.querySelector<HTMLInputElement>('input[name="partenza"]');
    if (arrival && departure) {
      arrival.min = toISODate(new Date());
      arrival.addEventListener('change', () => {
        const next = new Date(`${arrival.value}T00:00`);
        next.setDate(next.getDate() + 1);
        departure.min = toISODate(next);
        departure.disabled = !arrival.value;
        if (departure.value && departure.value < departure.min) departure.value = '';
      });
    }

    const show = (text: string, ok: boolean) => {
      response.textContent = text;
      response.classList.remove('hidden', 'alert-success', 'alert-error');
      response.classList.add(ok ? 'alert-success' : 'alert-error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = (await res.json()) as { ok: boolean; code: string };
        show(messages[data.code] ?? messages.error, data.ok);
        if (data.ok) {
          form.reset();
          if (departure) departure.disabled = true;
        }
      } catch {
        show(messages.error, false);
      } finally {
        submit.disabled = false;
        window.turnstile?.reset(form.querySelector('.cf-turnstile') ?? undefined);
      }
    });
  });
</script>
