---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../atoms/Button.astro';
// CSS nel frontmatter: finisce nell'<head>, così il layout è corretto prima che parta lo script
import 'swiper/css';
import 'swiper/css/effect-fade';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

interface Slide {
  image: ImageMetadata;
  title: string;
  text: string;
  cta: { label: string; href: string };
}

interface Props {
  slides: Slide[];
  class?: string;
}

const { slides, class: className = 'h-[70vh]' } = Astro.props;
---

<section class:list={['hero-swiper swiper min-h-105 w-full bg-neutral', className]}>
  <div class="swiper-wrapper h-full">
    {
      slides.map((slide, i) => (
        <div class="swiper-slide relative h-full">
          <Image
            src={slide.image}
            alt=""
            widths={[640, 1024, 1440, 1920]}
            quality={65}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="absolute inset-0 size-full object-cover"
          />
          <div class="absolute inset-0 bg-black/40" />
          <div class="relative flex h-full flex-col items-center justify-center gap-4 px-6 text-center text-white">
            <h2 class="text-6xl font-bold drop-shadow-lg md:text-7xl">{slide.title}</h2>
            <p class="max-w-2xl bg-black/50 px-2 text-lg">{slide.text}</p>
            <Button href={slide.cta.href} class="mt-4">
              {slide.cta.label}
            </Button>
          </div>
        </div>
      ))
    }
  </div>
  <div class="swiper-pagination"></div>
  <div class="swiper-button-prev text-white!"></div>
  <div class="swiper-button-next text-white!"></div>
</section>

<style>
  /* Prima dell'inizializzazione di Swiper mostra solo la prima slide (evita il flash di tutte le immagini) */
  .hero-swiper:not(.swiper-initialized) .swiper-slide:not(:first-child) {
    display: none;
  }
  /* Niente dissolvenza all'avvio: la prima slide compare subito, il fade vale solo per i cambi successivi */
  .hero-swiper:not(.is-ready) .swiper-slide {
    transition: none !important;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, EffectFade, Navigation, Pagination } from 'swiper/modules';

  document.querySelectorAll<HTMLElement>('.hero-swiper').forEach((el) => {
    new Swiper(el, {
      modules: [Autoplay, EffectFade, Navigation, Pagination],
      loop: true,
      effect: 'fade',
      autoplay: { delay: 5000, disableOnInteraction: false },
      pagination: { el: el.querySelector<HTMLElement>('.swiper-pagination'), clickable: true },
      navigation: {
        prevEl: el.querySelector<HTMLElement>('.swiper-button-prev'),
        nextEl: el.querySelector<HTMLElement>('.swiper-button-next'),
      },
      on: {
        afterInit: () => requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-ready'))),
      },
    });
  });
</script>
