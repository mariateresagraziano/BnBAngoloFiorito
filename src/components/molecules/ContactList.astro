---
import NavLink from '../atoms/NavLink.astro';
import { site } from '../../data/site';

interface Props {
  direction?: 'row' | 'col';
  /** Allineamento in colonna */
  align?: 'center' | 'start';
  class?: string;
}

const { direction = 'row', align = 'center', class: className } = Astro.props;
---

<address
  class:list={[
    'flex not-italic',
    direction === 'row' ? 'flex-row items-center gap-2' : 'flex-col',
    direction === 'col' && (align === 'start' ? 'items-start' : 'items-center'),
    className,
  ]}
>
  <NavLink href={site.mapsUrl} icon="fa6-solid:location-dot" external>{site.address}</NavLink>
  <NavLink href={`tel:${site.phone.replaceAll(' ', '')}`} icon="fa6-solid:phone">{site.phone}</NavLink>
  <NavLink href={`mailto:${site.email}`} icon="fa6-solid:envelope">{site.email}</NavLink>
</address>
