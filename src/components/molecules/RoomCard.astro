---
import Button from '../atoms/Button.astro';
import IconList from './IconList.astro';
import MediaBlock from './MediaBlock.astro';

interface Props {
  name: string;
  image: ImageMetadata;
  features: { icon: string; text: string }[];
  cta: { label: string; href: string };
  more?: { label: string; href: string };
}

const { name, image, features, cta, more } = Astro.props;
---

<MediaBlock image={image} alt={name}>
  <h3 class="text-3xl">{name}</h3>
  <IconList items={features} class="mt-4" />
  <div class="mt-8 flex flex-wrap items-center gap-6">
    <Button variant="primary" href={cta.href}>{cta.label}</Button>
    {more && <a href={more.href} class="link link-primary font-bold uppercase">{more.label}</a>}
  </div>
</MediaBlock>
