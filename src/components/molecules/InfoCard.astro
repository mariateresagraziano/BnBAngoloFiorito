---
// Riquadro informativo con icona e titolo (es. "Da sapere" nelle tariffe).
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  title: string;
  class?: string;
}

const { icon, title, class: className } = Astro.props;
---

<article class:list={['flex gap-4 rounded-box bg-base-200 p-6', className]}>
  <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary/15 text-secondary">
    <Icon name={icon} class="size-5" />
  </span>
  <div>
    <h4 class="text-lg font-bold">{title}</h4>
    <p class="mt-2 leading-relaxed">
      <slot />
    </p>
  </div>
</article>
