---
// Riquadro informativo con icona e titolo ("Da sapere" nelle tariffe, servizi in home e in Servizi).
// Con `href` il titolo diventa un link (es. verso il blocco di approfondimento).
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  title: string;
  href?: string;
  class?: string;
}

const { icon, title, href, class: className } = Astro.props;
---

<article class:list={['flex gap-4 rounded-box bg-base-200 p-6', className]}>
  <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary/15 text-secondary">
    <Icon name={icon} class="size-5" />
  </span>
  <div>
    <h3 class="text-lg font-bold">
      {
        href ? (
          <a href={href} class="link-hover inline-flex items-center gap-2 text-secondary">
            {title}
            <Icon name="fa6-solid:arrow-right" class="size-3" />
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="mt-2 leading-relaxed">
      <slot />
    </p>
  </div>
</article>
