---
// Scheda di un luogo nei dintorni: foto, titolo, testo e (facoltativo) link al percorso su Google Maps.
import { Image } from 'astro:assets';
import NavLink from '../atoms/NavLink.astro';

interface Props {
  slug: string;
  image: ImageMetadata;
  title: string;
  text: string;
  directions?: { label: string; href: string };
}

const { slug, image, title, text, directions } = Astro.props;
---

<article id={slug} class="flex scroll-mt-32 flex-col overflow-hidden rounded-box bg-base-100 shadow-sm">
  <Image
    src={image}
    alt={title}
    widths={[400, 600, 800]}
    sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
    class="aspect-4/3 w-full object-cover"
  />
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-2xl font-bold">{title}</h3>
    <p class="mt-3 flex-1 leading-relaxed">{text}</p>
    {
      directions && (
        <NavLink
          href={directions.href}
          icon="fa6-solid:route"
          external
          class="mt-4 -ml-3 self-start text-sm font-bold tracking-wider text-secondary uppercase"
        >
          {directions.label}
        </NavLink>
      )
    }
  </div>
</article>
