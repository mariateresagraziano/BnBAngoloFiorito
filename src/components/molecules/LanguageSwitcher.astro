---
import NavLink from '../atoms/NavLink.astro';
import { getLangFromUrl, languages, switchLangPath, type Lang } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
---

<nav class="flex gap-0.5 font-bold" aria-label="Lingua / Language">
  {
    (Object.keys(languages) as Lang[]).map((l) => (
      <NavLink href={switchLangPath(Astro.url, l)} hreflang={l} current={l === lang} class="uppercase">
        {l}
      </NavLink>
    ))
  }
</nav>
