---
import { getLangFromUrl, languages, switchLangPath, type Lang } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
---

<nav class="flex gap-3 font-bold" aria-label="Lingua / Language">
  {
    (Object.keys(languages) as Lang[]).map((l) => (
      <a
        href={switchLangPath(Astro.url, l)}
        hreflang={l}
        aria-current={l === lang ? 'true' : undefined}
        class:list={['uppercase hover:text-secondary', { 'text-secondary': l === lang }]}
      >
        {l}
      </a>
    ))
  }
</nav>
